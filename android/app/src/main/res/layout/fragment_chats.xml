<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ts_background_scaffold"
    tools:context=".ChatsFragment">

    <include layout="@layout/fragment_contacts" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/startNewChat"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="18dp"
        android:clickable="true"
        android:contentDescription="@string/button_hint_start_new_chat"
        android:focusable="true"
        app:backgroundTint="@color/ts_primary"
        app:borderWidth="0dp"
        app:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:maxImageSize="24dp"
        app:srcCompat="@drawable/ic_chat_white" />

</androidx.constraintlayout.widget.ConstraintLayout>