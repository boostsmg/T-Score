<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ChatsActivity">

    <include layout="@layout/toolbar" />

    <FrameLayout
        android:id="@+id/contentFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/ts_background_scaffold"/>

    <!-- Modern Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/mainBottomNav"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ts_bottom_nav_height"
        android:background="@color/ts_surface"
        app:menu="@menu/main_bottom_nav"
        app:labelVisibilityMode="labeled"
        app:itemIconSize="@dimen/ts_bottom_nav_icon_size"
        app:itemTextColor="@color/ts_text_caption"
        app:itemActiveIndicatorStyle="@style/Widget.MaterialComponents.BottomNavigationView.ActiveIndicator"
        app:itemRippleColor="@color/ts_primary_soft"/>

</LinearLayout>
