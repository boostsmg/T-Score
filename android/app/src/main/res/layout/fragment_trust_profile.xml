<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ts_background_scaffold"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/ts_screen_padding">

        <!-- Header: avatar + name + username -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/profileAvatar"
                android:layout_width="@dimen/ts_avatar_xlarge"
                android:layout_height="@dimen/ts_avatar_xlarge"
                android:contentDescription="@string/avatar"
                android:src="@drawable/ic_person_circle"
                app:shapeAppearanceOverlay="@style/roundImageView"/>

            <TextView
                android:id="@+id/profileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="T-Score User"
                android:textAppearance="@style/TS.Text.Headline"/>

            <TextView
                android:id="@+id/profileUsername"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@t-ScoreUser"
                android:textAppearance="@style/TS.Text.Subtitle"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/profileTrustBadge"
                style="@style/TS.Chip.Status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:checkable="false"
                android:text="New"
                app:chipBackgroundColor="@color/ts_success_bg"
                app:chipTextColor="@color/ts_success"/>
        </LinearLayout>

        <!-- Trust score prominent card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ts_section_gap"
            app:cardBackgroundColor="@color/ts_primary_light"
            app:cardCornerRadius="@dimen/ts_card_corner_radius">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:id="@+id/trustScoreLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your Trust Score"
                    android:textAppearance="@style/TS.Text.Section"/>

                <TextView
                    android:id="@+id/trustScoreValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="0 / 100"
                    android:textAppearance="@style/TS.Text.Headline"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/trustScoreStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="New — Start building trust with verified checks"
                    android:textAppearance="@style/TS.Text.Subtitle"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Verification section -->
        <TextView
            android:id="@+id/verificationSectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ts_section_gap"
            android:text="Verification progress"
            android:textAppearance="@style/TS.Text.Section"/>

        <!-- Verification items -->
        <LinearLayout
            android:id="@+id/verificationList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ts_section_gap_compact"
            android:orientation="vertical"/>

        <!-- Privacy section -->
        <TextView
            android:id="@+id/privacySectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ts_section_gap"
            android:text="Privacy"
            android:textAppearance="@style/TS.Text.Section"/>

        <TextView
            android:id="@+id/privacyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ts_section_gap_compact"
            android:text="Your CNIC number, document image and exact address will never be shown publicly. Other users will only see verification badges such as 'ID Verified' or 'Address Verified'."
            android:textAppearance="@style/TS.Text.Body"/>

        <!-- CTA button -->
        <Button
            android:id="@+id/profileSettingsButton"
            style="@style/TS.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ts_section_gap"
            android:text="Profile &amp; Verification Settings"/>

        <Space
            android:layout_width="match_parent"
            android:layout_height="40dp"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
