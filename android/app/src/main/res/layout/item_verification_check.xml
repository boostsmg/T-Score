<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/ts_surface_card"
    android:orientation="vertical"
    android:padding="@dimen/ts_item_padding_horizontal"
    android:layout_marginBottom="@dimen/ts_item_padding_vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/verifyIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/verification"
            android:src="@drawable/ic_circle"
            app:tint="@color/ts_text_caption"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/verifyTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TS.Text.Body"
                    android:textColor="@color/ts_text_headline"
                    android:textStyle="bold"
                    tools:text="Profile Photo"/>

                <TextView
                    android:id="@+id/verifyPoints"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="4dp"
                    android:textAppearance="@style/TS.Text.Caption"
                    android:textColor="@color/ts_text_caption"
                    tools:text="+5 points"/>
            </LinearLayout>

            <TextView
                android:id="@+id/verifyStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TS.Text.Caption"
                android:textColor="@color/ts_text_subtitle"
                tools:text="Not verified"/>
        </LinearLayout>

        <ImageView
            android:id="@+id/verifyChevron"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@string/next"
            android:src="@drawable/ic_chevron_up"
            android:rotation="90"
            app:tint="@color/ts_text_caption"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/ts_item_padding_vertical"
        android:background="@color/ts_divider_light"/>
</LinearLayout>
