<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/ts_screen_padding">

    <ImageView
        android:layout_width="@dimen/ts_empty_state_icon_size"
        android:layout_height="@dimen/ts_empty_state_icon_size"
        android:contentDescription="@string/empty_state"
        android:src="@drawable/ts_ic_empty_state"/>

    <TextView
        android:id="@+id/emptyTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textAppearance="@style/TS.Text.Section"
        android:textColor="@color/ts_text_headline"
        android:textAlignment="center"/>

    <TextView
        android:id="@+id/emptySubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textAppearance="@style/TS.Text.Subtitle"
        android:textColor="@color/ts_text_subtitle"
        android:textAlignment="center"/>
</LinearLayout>
