<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/ts_item_padding_vertical"
    app:cardBackgroundColor="@color/ts_surface_card"
    app:cardCornerRadius="@dimen/ts_card_corner_radius"
    app:cardElevation="@dimen/ts_card_elevation">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/ts_item_padding_horizontal">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/dealAvatar"
                android:layout_width="@dimen/ts_avatar_medium"
                android:layout_height="@dimen/ts_avatar_medium"
                android:contentDescription="@string/avatar"
                android:src="@drawable/ic_person_circle"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ts_item_padding_horizontal"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/dealTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TS.Text.Body"
                    android:textColor="@color/ts_text_headline"
                    android:textStyle="bold"
                    tools:text="Freelance Web Design"/>

                <TextView
                    android:id="@+id/dealCounterpart"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="@style/TS.Text.Caption"
                    android:textColor="@color/ts_text_subtitle"
                    tools:text="@johndoe • $450"/>
            </LinearLayout>

            <TextView
                android:id="@+id/dealAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TS.Text.Body"
                android:textColor="@color/ts_primary_dark"
                android:textStyle="bold"
                tools:text="$450"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/ts_item_padding_vertical"
            android:background="@color/ts_divider_light"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ts_item_padding_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/dealStatusLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status"
                android:textAppearance="@style/TS.Text.Caption"
                android:textColor="@color/ts_text_caption"/>

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/dealStatusChip"
                style="@style/TS.Chip.Status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="false"
                android:text="Active"
                app:chipBackgroundColor="@color/ts_info_bg"
                app:chipTextColor="@color/ts_info"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
