<com.google.android.material.appbar.AppBarLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/ts_surface"
    android:elevation="2dp"
    android:theme="@style/AppTheme.AppBarOverlay">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:background="@color/ts_surface"
        android:paddingEnd="4dp"
        android:theme="@style/ThemeOverlay.AppCompat.ActionBar"
        app:contentInsetEnd="4dp"
        app:contentInsetStartWithNavigation="2dp"
        app:popupTheme="@style/AppTheme.PopupOverlay"
        app:subtitleTextAppearance="@style/ToolbarSubtitleAppearance"
        app:titleTextColor="@color/ts_text_headline" />

    <co.tinode.tindroid.widgets.ConnectionAnimView
        android:id="@+id/offline_indicator"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_gravity="center_vertical"
        android:background="@color/ts_warning"
        android:visibility="invisible" />

</com.google.android.material.appbar.AppBarLayout>