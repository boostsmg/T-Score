# Keep the real file only on the VPS at /etc/t-score/trust-api.env with chmod 600.
# Never commit real passwords, Tinode token keys, admin keys, or evidence keys.
TSCORE_TRUST_DATABASE_URL=postgres://tscore:REPLACE_WITH_EXISTING_PASSWORD@127.0.0.1:5432/tscore?sslmode=disable
TSCORE_TRUST_ADMIN_KEY=REPLACE_WITH_RANDOM_SECRET
TSCORE_TRUST_ADDR=127.0.0.1:6061

# Must match the Tinode server token authenticator configuration.
# Base64-encoded HMAC key used to validate the Android app's existing login token.
TSCORE_TINODE_TOKEN_KEY=REPLACE_WITH_EXISTING_TINODE_TOKEN_KEY_BASE64
TSCORE_TINODE_TOKEN_SERIAL=REPLACE_WITH_EXISTING_TINODE_TOKEN_SERIAL

# Optional but required to accept private CNIC/address/liveness/photo evidence uploads.
# Use a separate high-entropy base64 AES key and keep the evidence directory private.
TSCORE_VERIFICATION_EVIDENCE_KEY=REPLACE_WITH_RANDOM_BASE64_AES_KEY
TSCORE_VERIFICATION_EVIDENCE_DIR=/var/lib/t-score/private-evidence
